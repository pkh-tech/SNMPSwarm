#!/usr/bin/env python3
"""Run snmpwalk against every running container in one SNMPSwarm."""
import argparse
import json
import shutil
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description="Dump SNMP data from all running SNMPSwarm units")
    parser.add_argument("--name", default="snmpswarm", help="Swarm name (default: snmpswarm)")
    parser.add_argument("--community", default="public", help="SNMPv2c community (default: public)")
    parser.add_argument("--oid", default="1.3.6.1.2.1", help="OID subtree to walk (default: 1.3.6.1.2.1)")
    parser.add_argument("--timeout", type=float, default=0.5, help="SNMP timeout seconds (default: 0.5)")
    args = parser.parse_args()

    for command in ("docker", "snmpwalk"):
        if not shutil.which(command):
            print(f"Error: {command} command not found", file=sys.stderr)
            return 2

    ps = subprocess.run([
        "docker", "ps", "-q",
        "--filter", "label=network-swarm.managed=true",
        "--filter", f"label=network-swarm.name={args.name}",
    ], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    ids = [x for x in ps.stdout.splitlines() if x.strip()]
    if ps.returncode != 0:
        print(ps.stderr.strip() or "Error querying Docker", file=sys.stderr)
        return 2
    if not ids:
        print(f"No running SNMPSwarm containers found for '{args.name}'.")
        return 1

    inspect = subprocess.run(["docker", "inspect", *ids], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if inspect.returncode != 0:
        print(inspect.stderr.strip() or "Error inspecting containers", file=sys.stderr)
        return 2

    rows = []
    for item in json.loads(inspect.stdout):
        labels = item.get("Config", {}).get("Labels", {}) or {}
        try:
            device_id = int(labels.get("network-swarm.device-id", 0))
        except ValueError:
            device_id = 0
        networks = item.get("NetworkSettings", {}).get("Networks", {}) or {}
        ip = next((n.get("IPAddress") for n in networks.values() if n.get("IPAddress")), "")
        rows.append((device_id, item.get("Name", "").lstrip("/"), ip))

    for device_id, name, ip in sorted(rows):
        print("\n" + "=" * 60)
        print(f"DEVICE {device_id:03d}  {ip}  {name}")
        print("=" * 60)
        if not ip:
            print("[NO IP ADDRESS]")
            continue
        result = subprocess.run([
            "snmpwalk", "-v2c", "-c", args.community,
            "-On", "-t", str(args.timeout), "-r", "0", ip, args.oid,
        ], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        if result.stdout:
            print(result.stdout.rstrip())
        if result.returncode != 0:
            print("[NO SNMP RESPONSE]")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
